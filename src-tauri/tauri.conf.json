{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IELTS Copilot",
  "version": "0.1.0",
  "identifier": "com.fanyunxu.ieltscopilot",
  "build": {
    "frontendDist": "./loading"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "IELTS Copilot",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["server/", "runtime/node.exe", "../config.example.json", "seed-data/app.db"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
